# Settings for dev, your workstation. Copy this file to deploy/dev.env
# (gitignored) and edit it there if needed. scripts/fetch-secrets.sh copies
# deploy/dev.env into .env. Dev has no Key Vault, so the throwaway secrets
# below take its place. Nothing outside your workstation can reach the stack.

# Blob Storage account holding the CSVs (scripts/data.sh). Dev reads stg's.
DSV_STORAGE_ACCOUNT=stdsvstg01

DSV_DB_PORT=5432
# Must be "dinesafe": init.sql grants privileges on a database of that name.
DSV_DB_NAME=dinesafe
DSV_DB_USER=dsv_admin
DSV_ANALYTICS_ADMIN_USER=dsv-analytics-admin
DSV_ANALYTICS_ROOT_URL=http://localhost:8080/analytics/

# Throwaway secrets. Same rules as Key Vault: letters, digits, and . _ ~ -
# only. The database reads its passwords once, when its volume is new, so
# after changing one run `docker compose down -v` and deploy again.
DSV_DB_PASSWORD=dev-db-password
DSV_DB_MIGRATOR_PASSWORD=dev-db-migrator-password
DSV_DB_APP_PASSWORD=dev-db-app-password
DSV_ANALYTICS_ADMIN_PASSWORD=dev-analytics-admin-password
