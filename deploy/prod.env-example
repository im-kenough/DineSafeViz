# Non-secret settings for prod. On the VM, copy this file to deploy/prod.env
# (gitignored) and edit it there if needed. scripts/fetch-secrets.sh copies
# deploy/prod.env into .env and adds the secrets from DSV_KEY_VAULT.
DSV_KEY_VAULT=kv-dsv-prod01
DSV_DB_PORT=5432
DSV_DB_NAME=dinesafe
DSV_DB_USER=dsv_admin
DSV_ANALYTICS_ADMIN_USER=dsv-analytics-admin
DSV_ANALYTICS_ROOT_URL=https://dinesafeviz.com/analytics/
