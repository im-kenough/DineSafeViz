# Non-secret settings for stg. On the VM, copy this file to deploy/stg.env
# (gitignored) and edit it there if needed. scripts/fetch-secrets.sh copies
# deploy/stg.env into .env and adds the secrets from DSV_KEY_VAULT.
DSV_KEY_VAULT=kv-dsv-stg01

# Blob Storage account holding the CSVs (scripts/data.sh).
DSV_STORAGE_ACCOUNT=stdsvstg01

DSV_DB_PORT=5432
DSV_DB_NAME=dinesafe
DSV_DB_USER=dsv_admin
DSV_ANALYTICS_ADMIN_USER=dsv-analytics-admin
DSV_ANALYTICS_ROOT_URL=https://stg.dinesafeviz.com/analytics/
