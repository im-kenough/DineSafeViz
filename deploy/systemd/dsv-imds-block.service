# Containers must not reach the instance metadata service (169.254.169.254),
# where any process can get tokens as the VM's managed identity, or the
# WireServer (168.63.129.16). DOCKER-USER runs before Docker's own FORWARD
# rules and Docker never edits it. The host's own traffic (OUTPUT chain,
# used by fetch-secrets.sh and data.sh) isn't affected.
# Installed by docs/how-to/azure-vm/vm-first-time-setup.md.
[Unit]
Description=Block container access to Azure IMDS and WireServer
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for ip in 169.254.169.254 168.63.129.16; do iptables -C DOCKER-USER -d $ip/32 -j DROP 2>/dev/null || iptables -I DOCKER-USER -d $ip/32 -j DROP; done'
ExecStop=/bin/sh -c 'for ip in 169.254.169.254 168.63.129.16; do iptables -D DOCKER-USER -d $ip/32 -j DROP 2>/dev/null || true; done'

[Install]
WantedBy=docker.service
