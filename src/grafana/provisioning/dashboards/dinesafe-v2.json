    {
      "datasource": {
        "type": "grafana-postgresql-datasource"
      },
      "description": "A Pass notice will be issued when only minor or no infractions are observed during an inspection.\n\nIf minor infractions are repeated at the next inspection, the Public Health Inspector may issue a ticket to obtain compliance. Fines range from $55 to $465 depending on the severity of the infraction.\nMinor infraction type\n\n    Infractions that present a minimal health risk\n    These items must be corrected by the next inspection\n\nExamples\n\n    Walls, floors or other non-food contact surfaces or equipment need cleaning or repair (e.g., cracked or missing floor tiles, cracked or peeling paint not directly over food preparation area)\n    Inadequate ventilation and lighting systems\n    Hair constraints not worn\n",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
