          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT COUNT(*) AS \"Total\" FROM inspections WHERE $__timeFilter(inspection_date))\n -(SELECT COUNT(*) AS \"Closed\" FROM inspections WHERE severity = 'C - Crucial' AND $__timeFilter(inspection_date))\n -(SELECT COUNT(*) AS \"cond_pass\" FROM inspections WHERE severity = 'S - Significant' AND $__timeFilter(inspection_date))\n AS Difference",
          "refId": "A",
