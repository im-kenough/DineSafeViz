#!/usr/bin/env bash
# Test double for docker, used through PATH by tests/test_deploy.py.
echo "docker $*" >> "${FAKE_LOG:-/dev/null}"
case "$1 $2" in
  "manifest inspect")
    if [[ " ${FAKE_MISSING_IMAGES:-} " == *" ${3##*/} "* ]]; then
      echo "no such manifest: $3" >&2
      exit 1
    fi
    echo '{}'
    ;;
  "compose up")
    # The --wait call checks health; the first call only starts the stack.
    if [[ " $* " == *" --wait "* ]]; then
      exit "${FAKE_UP_WAIT_EXIT:-0}"
    fi
    exit "${FAKE_UP_EXIT:-0}"
    ;;
  "compose wait")
    code=0
    [[ $3 == dsv-init-db ]] && code=${FAKE_INIT_DB_EXIT:-0}
    echo "container \"fake\" exited with status code $code"
    exit "$code"
    ;;
  "compose ps")
    if [[ " $* " == *" --format json "* ]]; then
      printf '%s\n' "${FAKE_PS_JSON:-}"
    else
      echo "NAME   STATUS"
    fi
    ;;
  "compose logs")
    echo "fake logs for ${*: -1}"
    ;;
  "compose exec")
    # deploy.sh: does inspections have rows?
    if [[ $* == *"FROM inspections"* ]]; then
      echo "${FAKE_DB_HAS_ROWS:-t}"
      exit 0
    fi
    # deploy.sh: a migration piped into psql
    if [[ $* == *"ON_ERROR_STOP"* ]]; then
      cat >/dev/null
      exit "${FAKE_MIGRATE_EXIT:-0}"
    fi
    if [[ $* == *"dsv-tunnel:2000/ready"* && -n ${FAKE_TUNNEL_NOT_READY:-} ]]; then
      echo "wget: server returned error: HTTP/1.1 503 Service Unavailable" >&2
      exit 1
    fi
    if [[ $* == *"169.254.169.254"* ]]; then
      # The real check expects wget to fail; FAKE_IMDS_REACHABLE makes it succeed.
      [[ -n ${FAKE_IMDS_REACHABLE:-} ]] && exit 0
      exit 1
    fi
    ;;
  "compose --profile")
    # pipeline.sh: docker compose --profile pipeline run --rm ... dsv-pipeline <command>
    # deploy.sh:   docker compose --profile pipeline pull --quiet [dsv-pipeline]
    if [[ $4 == run ]]; then
      exit "${FAKE_PIPELINE_EXIT:-0}"
    fi
    ;;
  "compose run")
    exit "${FAKE_LOAD_EXIT:-0}"
    ;;
  "compose pull" | "image prune")
    ;;
  *)
    echo "fake docker: unexpected: $*" >&2
    exit 99
    ;;
esac
