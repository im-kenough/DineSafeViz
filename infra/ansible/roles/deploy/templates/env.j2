# PostgreSQL
DSV_DB_HOST=dsv-db
DSV_DB_PORT=5432
DSV_DB_NAME={{ vault_db_name }}
DSV_DB_USER={{ vault_db_user }}
DSV_DB_PASSWORD={{ vault_db_password }}

# Analytics dashboard (Grafana)
DSV_ANALYTICS_ADMIN_USER={{ vault_analytics_admin_user }}
DSV_ANALYTICS_ADMIN_PASSWORD={{ vault_analytics_admin_password }}
DSV_ANALYTICS_ROOT_URL=http://{{ vm_ip }}:5000/analytics/
