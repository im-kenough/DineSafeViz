# {{ ansible_managed }}
# DineSafeViz environment configuration — rendered by Ansible from vault.
# DO NOT edit manually. Rerun `make deploy-app` to update.

# PostgreSQL
DSV_DB_HOST={{ app_analytics_db_host }}
DSV_DB_PORT={{ app_analytics_db_port }}
DSV_DB_NAME={{ vault_db_name }}
DSV_DB_USER={{ vault_db_user }}
DSV_DB_PASSWORD={{ vault_db_password }}

# Analytics dashboard (Grafana)
# DSV-Analytics: Analytics dashboard configuration
#############################################
# Grafana is used to visualize and analyze data.
DSV_ANALYTICS_ADMIN_USER={{ vault_analytics_admin_user }}
DSV_ANALYTICS_ADMIN_PASSWORD={{ vault_analytics_admin_password }}
DSV_ANALYTICS_ROOT_URL=http://{{ app_vm_ip }}:5000/analytics/
