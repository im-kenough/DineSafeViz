# {{ ansible_managed }}
# DO NOT edit manually. Rerun `make deploy-app` to update.

# --- DSV Variables (Modern) ---

# PostgreSQL
DSV_DB_HOST={{ app_analytics_db_host }}
DSV_DB_PORT={{ app_analytics_db_port }}
DSV_DB_NAME={{ app_analytics_db_name }}
DSV_DB_USER={{ app_analytics_db_user }}
DSV_DB_PASSWORD={{ vault_db_password }}
DSV_DB_APP_USER={{ app_analytics_db_app_user | default('dinesafe_app') }}
DSV_DB_APP_PASSWORD={{ vault_db_app_password | default('dinesafe_app') }}

# Grafana
DSV_ANALYTICS_ADMIN_USER={{ app_analytics_admin_user }}
DSV_ANALYTICS_ADMIN_PASSWORD={{ vault_analytics_admin_password }}
DSV_ANALYTICS_ROOT_URL=http://{{ app_vm_ip }}:8080/analytics/
