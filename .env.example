# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# DSV-DB: PostgresQL database configurations
#############################################
# PostgreSQL port
DSV_DB_PORT=5432

# Database username
DSV_DB_USER=dsv-db-user

# Database password
DSV_DB_PASSWORD=changeme

# Database name
# Must be "dinesafe": init.sql grants privileges on a database of that name.
DSV_DB_NAME=dinesafe

# DSV-Init-DB: data source
#############################################
# dsv-init-db loads the CSVs in ./data. Fill it from stg Blob Storage with
# `az login` (dsv-ops01) and then `scripts/data.sh local`.
# See docs/how-to/deploy-locally.md.

# DSV-Analytics: Analytics dashboard configuration
#############################################
# Grafana is used to visualize and analyze data.
# Access the admin console at localhost:3000/analytics/
# Does it have to be admin? Is it a reserved username?

# Grafana builtin admin username
DSV_ANALYTICS_ADMIN_USER=admin

# Grafana admin password
DSV_ANALYTICS_ADMIN_PASSWORD=changeme